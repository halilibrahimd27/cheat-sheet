# cheat-sheet configuration — copy to your shell/env as needed.
# These are NOT auto-loaded; pass them inline (e.g. `PORT=8080 npm start`)
# or via Docker / your process manager.

# Port to listen on.
PORT=3000

# Bind address. 127.0.0.1 = localhost only (default, recommended).
# Set to 0.0.0.0 ONLY if you intend to reach it from another machine — and set
# AUTH_PASS below when you do. The Host check still runs (see ALLOWED_HOSTS),
# but it is a rebinding guard, not access control: anyone who can reach the
# port can reach your data unless Basic Auth is on.
HOST=127.0.0.1

# Extra Host header values to accept, comma separated. The Host check in
# server.js exists to stop a DNS-rebinding page from driving your instance, and
# it runs in EVERY configuration — including HOST=0.0.0.0, which is what the
# Docker image sets. Accepted without any configuration:
#
#   - the loopback names (localhost, 127.0.0.1, ::1) on any port
#   - any bare IP literal, e.g. 192.168.1.10:8899 — a rebinding attack has to
#     address you by a NAME it controls, so a literal cannot be rebound
#   - the value of HOST itself, when HOST is a specific address
#   - anything listed here in ALLOWED_HOSTS
#
# Every other Host header gets 403 "forbidden host". So a normal local run and a
# container published on 127.0.0.1 need nothing here. Set it when the app is
# reached by a NAME other than localhost: a machine hostname, or the domain a
# reverse proxy terminates.
# ALLOWED_HOSTS=cheatsheet.example.com,192.168.1.10

# Optional HTTP Basic Auth. When AUTH_PASS is set, every request requires it.
# AUTH_USER=admin
# AUTH_PASS=change-me

# Max request body size (image uploads + full DB import).
JSON_LIMIT=12mb

# Where every persistent JSON store and the evidence-screenshot uploads live.
# Defaults to ./data next to server.js. Point it at a mounted volume when the
# app runs from a read-only image, and back it up — it is the only state the
# app has that seed.js does not.
DATA_DIR=./data
